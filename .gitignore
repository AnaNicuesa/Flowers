# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# Environment variables / secrets
.env

# Data (downloaded, not versioned)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model artifacts (large binaries)
models/checkpoints/*
!models/checkpoints/.gitkeep
!models/checkpoints/class_names.json
*.h5
*.keras
*.pb

# Reports / generated figures (regenerated by notebooks)
reports/figures/*
!reports/figures/.gitkeep
!reports/figures/00_pipeline_overview.png
!reports/figures/00_app_screenshot.png

# LaTeX build artifacts
presentations/*.aux
presentations/*.log
presentations/*.out
presentations/*.toc
presentations/*.bbl
presentations/*.blg
presentations/*.nav
presentations/*.snm
presentations/*.synctex.gz
presentations/*.fdb_latexmk
presentations/*.fls

# OS / editor
.DS_Store
.vscode/
.idea/

# Jupyter
*.ipynb_checkpoints

.pytest_cache/
.claude/
